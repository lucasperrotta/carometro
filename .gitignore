dist/
build/

# Variáveis de ambiente
.env
.env.local
.env.production

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Thumbnails
Thumbs.db

# Testes
coverage/

# Temporários
*.tmp
*.temp
.next/
*.log
